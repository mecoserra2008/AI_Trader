# Copy to .env and fill in. Never commit .env. Bybit keys: read + trade only, NEVER withdrawal.
# AI_TRADER_ENVIRONMENT=demo          # demo | testnet | mainnet (overrides settings.yaml)
# AI_TRADER_ALLOW_MAINNET=0           # second key for real-money trading (also needs execution.allow_mainnet)
# RUST_LOG=info

# Demo Trading keys: create inside the Bybit mainnet account -> Demo Trading -> API
